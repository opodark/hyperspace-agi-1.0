# HyperSpace-AGI v1.0 — Template configurazione nodo
# Copia in .env e personalizza, oppure esegui ./setup.sh (macOS/Linux) o .\setup.ps1 (Windows)
# NON committare .env — è già in .gitignore

# ── Identità del nodo ──────────────────────────────────────────
NODE_NICKNAME=il-mio-nodo          # nome che scegli tu (es: macbook-luca, server-mario)
NODE_ID=il-mio-nodo-ab12           # generato automaticamente da setup — oppure personalizzalo
NODE_LOCATION=MacBook Air M5       # descrizione libera della macchina
NODE_OWNER=nome-utente             # il tuo nome
NODE_TAGS=dev,macos,arm64          # tag liberi, separati da virgola

# ── Sicurezza ─────────────────────────────────────────────────
HYPERSPACE_CLUSTER_SECRET=         # stesso valore su tutti i nodi della rete (vuoto = disabilitato)

# ── Hardware ──────────────────────────────────────────────────
NODE_RAM_GB=16                     # RAM totale della macchina in GB (usata per auto-pull modelli)

# ── Estetica (opzionale) ──────────────────────────────────────
NODE_COLOR=#7c3aed                 # colore hex per la dashboard
NODE_AVATAR_STYLE=bottts           # stile avatar DiceBear
